# License Server Environment Configuration — template.
#
# Copy to config.env and fill in. config.env is gitignored and must never be
# committed. Every value below is a placeholder: no real credential belongs in
# this file or anywhere else in the repository.

# production | staging | development
ENVIRONMENT=production

# Database. DB_NAME, DB_USER and DB_PASS are required — config.php refuses to
# load without them rather than falling back to a value baked into the source.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Security keys. Generate separately, and never reuse one as the other:
#   php -r "echo bin2hex(random_bytes(32));"
API_KEY=
ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=

# Session
SESSION_NAME=apeiron_license_admin
SESSION_TIMEOUT=3600

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
